				"id": {
					"type": "string"
				},
				"origin": {
					"enum": [
						"request",
						"suggestion",
						"technical"
					]
				},
				"selected": {
					"type": "boolean"
				},
				"adopted_from_suggestion": {
					"type": "boolean"
				},
				"doctype": {
					"type": "string"
				},
				"name": {
					"type": "string"
				},
				"states": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"name": {
								"type": "string"
							},
							"docstatus": {
								"$ref": "#/$defs/tri"
							},
							"editable_by": {
								"type": "string"
							}
						}
					}
				},
				"transitions": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"action": {
								"type": "string"
							},
							"from": {
								"type": "string"
							},
							"to": {
								"type": "string"
							},
							"role": {
								"type": "string"
							},
							"condition": {
								"type": "string"
							}
						}
					}
				},
