					"type": "string"
				},
				"purpose": {
					"type": "string"
				},
				"source": {
					"type": "string"
				},
				"columns": {
					"type": "string"
				},
				"filters": {
					"type": "string"
				},
				"sort": {
					"type": "string"
				},
				"aggregation": {
					"type": "string"
				},
				"permission": {
					"type": "string"
				},
				"report_type": {
