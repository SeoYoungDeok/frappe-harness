				},
				"flow": {
					"type": "string"
				},
				"reference_images": {
					"$ref": "#/$defs/strList"
				},
				"suggestion_group": {
					"type": "string"
				}
			}
		},
		"report": {
			"type": "object",
			"properties": {
				"id": {
					"type": "string"
				},
				"origin": {
					"enum": [
						"request",
						"suggestion",
						"technical"
					]
				},
				"selected": {
					"type": "boolean"
				},
				"adopted_from_suggestion": {
					"type": "boolean"
				},
